# .env.sample - Sample Environment Variables

# Application Configuration
APP_PORT=3310
APP_SECRET=YOUR_APP_SECRET_KEY

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=YOUR_DATABASE_USERNAME
DB_PASSWORD=YOUR_DATABASE_PASSWORD
DB_NAME=YOUR_DATABASE_NAME
CSV_PATH1="./database/import_csv/import_files/tableau_bornes.csv"
CSV_PATH2="./database/import_csv/import_files/vehicle_brand.csv"
CSV_PATH3="./database/import_csv/import_files/type_of_sockets.csv"
CSV_PATH4="./database/import_csv/import_files/vehicle_template.csv"

#Nodemailer Configuration

SMTP_HOST=smtp.gmail.com
SMTP_USER=YOUR_MAIL
SMTP_PASS=YOUR_MAIL_PASSWORD


# Client URL (for CORS configuration)
CLIENT_URL=http://localhost:3000

# About specific needs, please ask your trainer about the deploiement project name and follow the pattern
# You can add as much variable as needed. Don't forget to tell your trainer about it. Otherwise, it could break on deploiement
PROJECT_NAME_SPECIFIC_NAME=YOUR_SPECIFIC_VALUE
